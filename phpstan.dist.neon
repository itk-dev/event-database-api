includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
#        - tests/
    excludePaths:
        # Auto-generated by the config reference dumper; not hand-maintained.
        - config/reference.php
    ignoreErrors:
        - identifier: missingType.generics
        - identifier: missingType.iterableValue
        # The ID properties are set reflectively by API Platform.
        - '#Property App\\Api\\Dto\\[^\\]+::\$id is unused#'
